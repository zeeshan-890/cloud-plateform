# syntax=docker/dockerfile:1.7
#
# Build worker. Unlike every other service it needs:
#   * git + openssh-client  (clone customer repositories; github.com host keys are PINNED below)
#   * docker-cli + buildx   (talks to the HOST docker daemon through the mounted socket)
#   * trivy                 (image vulnerability scan, enabled with TRIVY_ENABLED=true)
#   * ca-certificates
#
# SECURITY: access to the Docker socket is equivalent to root on the host. The container itself runs
# as uid 10001 and receives the socket's group via compose `group_add: [$DOCKER_GID]`. Customer code
# is built by the host daemon, NOT executed inside this container. See docs/SECURITY.md.

ARG GO_VERSION=1.22.12
ARG ALPINE_VERSION=3.21
ARG TRIVY_VERSION=0.58.2

FROM aquasec/trivy:${TRIVY_VERSION} AS trivy

FROM --platform=$BUILDPLATFORM golang:${GO_VERSION}-alpine${ALPINE_VERSION} AS build
ARG TARGETOS=linux
ARG TARGETARCH
ARG VERSION=dev
ARG COMMIT=unknown
WORKDIR /src
ENV CGO_ENABLED=0 GOFLAGS=-mod=readonly GOWORK=off GOTOOLCHAIN=local
COPY packages/go-common ./packages/go-common
COPY packages/events ./packages/events
COPY services/worker/go.mod services/worker/go.sum ./services/worker/
WORKDIR /src/services/worker
RUN --mount=type=cache,target=/go/pkg/mod go mod download
COPY services/worker /src/services/worker
RUN --mount=type=cache,target=/go/pkg/mod --mount=type=cache,target=/root/.cache/go-build \
    GOOS=${TARGETOS} GOARCH=${TARGETARCH} \
    go build -trimpath -ldflags="-s -w -X main.version=${VERSION} -X main.commit=${COMMIT}" -o /out/service ./cmd

FROM alpine:3.21.3
ARG VERSION=dev
ARG COMMIT=unknown
LABEL org.opencontainers.image.title="jp-worker" \
      org.opencontainers.image.source="https://github.com/zeeshan-890/cloud-plateform" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${COMMIT}"
RUN apk add --no-cache ca-certificates tzdata git openssh-client docker-cli docker-cli-buildx && \
    adduser -D -u 10001 -h /home/jp -s /sbin/nologin jp && \
    mkdir -p /work /cache && chown jp:jp /work /cache
# github.com host keys, pinned in-repo (CI verifies them against https://api.github.com/meta)
COPY infra/docker/github_known_hosts /etc/ssh/ssh_known_hosts
RUN chmod 644 /etc/ssh/ssh_known_hosts
COPY --from=trivy /usr/local/bin/trivy /usr/local/bin/trivy
WORKDIR /app
COPY --from=build /out/service /app/service
ENV PORT=8008 WORK_DIR=/work BUILD_MODE=docker HOME=/home/jp \
    DOCKER_CONFIG=/tmp/.docker TRIVY_CACHE_DIR=/cache/trivy \
    GIT_SSH_COMMAND="ssh -o StrictHostKeyChecking=yes -o UserKnownHostsFile=/etc/ssh/ssh_known_hosts"
USER 10001:10001
HEALTHCHECK --interval=10s --timeout=3s --start-period=20s --retries=5 \
  CMD wget -qO /dev/null "http://127.0.0.1:${PORT}/healthz" || exit 1
ENTRYPOINT ["/app/service"]
