# Development defaults for infra/compose/docker-compose.dev.yml.
# NEVER use these values on a reachable server. They are public knowledge.
# Usage: scripts/jp-up.sh --dev   (adds --env-file infra/compose/dev.env automatically)
JP_ENV=development
JP_LOG_LEVEL=debug
ROOT_DOMAIN=jp.localhost
PUBLIC_BASE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
TLS_ENABLED=false
REGISTRATION_MODE=open
JWT_SECRET=dev-only-jwt-secret-0123456789abcdef0123456789abcdef
INTERNAL_TOKEN=dev-only-internal-token-0123456789abcdef
# base64 of 32 bytes (all 0x41)
SECRETS_MASTER_KEY=QUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUE=
AI_ENC_KEY=QkJCQkJCQkJCQkJCQkJCQkJCQkJCQkJCQkJCQkJCQkI=
POSTGRES_USER=jp
POSTGRES_PASSWORD=jp_dev_password
POSTGRES_DB=jp
REDIS_PASSWORD=jp_dev_redis
REGISTRY_HTTP_SECRET=dev-registry-secret
MINIO_ROOT_USER=jpdevminio
MINIO_ROOT_PASSWORD=jpdevminio-secret
GRAFANA_ADMIN_PASSWORD=jpdevgrafana
# basic-auth for the Traefik dashboard: admin / devpassword
TRAEFIK_DASHBOARD_AUTH='admin:$apr1$GLzVzXfP$JNGKUJLG9XWsUPQGD5OyU.'
PREVIEW_BASE_DOMAIN=preview.jp.localhost
DOMAIN_CNAME_TARGET=cname.jp.localhost
DASHBOARD_BIND=127.0.0.1
# Docker Desktop / local engines: the socket is reachable by root only inside the VM
DOCKER_GID=0
IDENTITY_ENC_KEY=Q0NDQ0NDQ0NDQ0NDQ0NDQ0NDQ0NDQ0NDQ0NDQ0NDQ0M=
REPO_ENC_KEY=REREREREREREREREREREREREREREREREREREREREREU=
