# JP Cloud - environment reference.
#
# install.sh / install.ps1 generate a complete `.env` for you (chmod 600) and never overwrite an existing one.
# This file documents EVERY variable the stack reads. Lines that are commented out are optional.
# Values marked REQUIRED make `docker compose` refuse to start when empty.
# `scripts/verify-env.sh` fails CI if a service reads a variable that is neither here nor in the compose files.
#
# Quote values containing `$` with single quotes: TRAEFIK_DASHBOARD_AUTH='admin:$apr1$...'

# ============================================================ identity of the install
# REQUIRED. Base domain for generated app hostnames: <project>-<org>.<ROOT_DOMAIN>.
# IP-only installs use <ip-with-dashes>.sslip.io (wildcard DNS) e.g. 203-0-113-10.sslip.io
ROOT_DOMAIN=
# Hostname of the management panel (dashboard + /api), e.g. panel.example.com. Empty = panel reachable by bare IP only.
MANAGEMENT_DOMAIN=
# REQUIRED. Public URL of the panel as users type it (used for CORS, links in e-mails, GitHub callbacks).
PUBLIC_BASE_URL=
# Comma separated allowed browser origins. Default: PUBLIC_BASE_URL.
# CORS_ORIGINS=
# Public IPv4 of this server (shown as the A-record target in the domains guide).
PUBLIC_IP=
# CNAME target customers point custom domains to. Empty = A record to PUBLIC_IP only.
DOMAIN_CNAME_TARGET=
# DOMAIN_A_TARGETS=
# Hostnames for PR previews are <slug>.<PREVIEW_BASE_DOMAIN>. Needs wildcard DNS (sslip.io works).
PREVIEW_BASE_DOMAIN=

# ============================================================ TLS (Let's Encrypt via Traefik)
# true  -> Traefik issues certificates for every verified host, http->https redirect on.
#          Requires ACME_EMAIL and MANAGEMENT_DOMAIN, ports 80+443 reachable from the internet.
# false -> plain http only (IP installs / local testing).
TLS_ENABLED=false
ACME_EMAIL=
# true = Let's Encrypt staging CA (untrusted certs, no rate limits) while testing
ACME_STAGING=false
# max-age for HSTS on the panel; set 31536000 once TLS works
HSTS_SECONDS=0

# ============================================================ runtime mode
JP_ENV=production
JP_LOG_LEVEL=info
# Group id owning /var/run/docker.sock (runtime + worker run as uid 10001 plus this group). Installer: stat -c %g /var/run/docker.sock
DOCKER_GID=
BUILD_MODE=docker
RUNTIME_MODE=docker
# Image vulnerability scan after each build (worker image ships trivy). Needs outbound internet for the vuln DB.
TRIVY_ENABLED=true
# closed | invite (default) | open. Applies after the first admin account has been bootstrapped.
REGISTRATION_MODE=invite
# CIDRs whose X-Forwarded-For is trusted by the gateway (the Docker networks Traefik lives on).
TRUSTED_PROXIES=172.16.0.0/12,10.0.0.0/8,192.168.0.0/16

# ============================================================ secrets (all REQUIRED; installer generates them)
# >= 32 random chars
JWT_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h
# shared secret for service-to-service calls (/internal/*)
INTERNAL_TOKEN=
# base64 of 32 random bytes. LOSING THIS KEY MAKES ALL STORED SECRETS UNREADABLE - back it up (scripts/backup.sh does).
SECRETS_MASTER_KEY=
# base64 of 32 random bytes; encrypts per-organization AI provider keys
AI_ENC_KEY=
# Secret-key rotation (secret service): bump the version, keep the old key in *_PREVIOUS, call the rotate endpoint, then remove *_PREVIOUS
SECRETS_KEY_VERSION=
SECRETS_MASTER_KEY_PREVIOUS=
SECRETS_KEY_VERSION_PREVIOUS=
# base64 of 32 random bytes; encrypts TOTP seeds + persisted settings in the identity service
IDENTITY_ENC_KEY=
# base64 of 32 random bytes; encrypts stored repository tokens and deploy keys (repository service)
REPO_ENC_KEY=
# optional: if set, creating the first admin (POST /auth/bootstrap) must present this token
BOOTSTRAP_TOKEN=
POSTGRES_USER=jp
POSTGRES_PASSWORD=
POSTGRES_DB=jp
REDIS_PASSWORD=
REGISTRY_HTTP_SECRET=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
# htpasswd line for the Traefik dashboard (127.0.0.1:8080, ssh tunnel only). `openssl passwd -apr1` format.
TRAEFIK_DASHBOARD_AUTH=
# informational copy of the dashboard password, not read by any service
# TRAEFIK_DASHBOARD_PASSWORD=
# only used by scripts/restore.sh checks; not read by services
# BACKUP_DIR=/var/backups/jp

# ============================================================ GitHub (optional)
# Per-repository webhook secrets are generated by the platform. This global one is only for legacy hooks.
GITHUB_WEBHOOK_SECRET=
# never "stub" in production
GITHUB_MODE=
# GitHub App (installation repo list, commit statuses): https://github.com/settings/apps
#   Setup URL:   <PUBLIC_BASE_URL>/api/v1/github/setup
#   Webhook URL: <PUBLIC_BASE_URL>/api/v1/webhooks/github
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_PRIVATE_KEY_PATH=
# Personal access token fallback for listing/cloning private repos without a GitHub App
GITHUB_TOKEN=

# ============================================================ e-mail (optional; invitations, notifications)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# starttls | tls | none
SMTP_TLS=starttls

# ============================================================ AI assistant (optional)
# Provider keys (OpenAI-compatible, Gemini, OpenRouter) are configured in the dashboard: per organization (encrypted with AI_ENC_KEY)
# or platform-wide (System settings, stored by the identity service). No provider key lives in this file.
# Optional platform-wide fallback used when no key is set in the dashboard:
AI_PLATFORM_PROVIDER=
AI_PLATFORM_MODEL=
AI_PLATFORM_KEY=
AI_MODEL=
GEMINI_MODEL=
OPENAI_API_KEY=
AI_BASE_URL=
AI_RATE_PER_MIN=
AI_ALLOW_PRIVATE_BASE_URL=false

# ============================================================ storage (MinIO)
# MINIO_VERSION=RELEASE.2025-04-22T22-12-26Z  (built from source: upstream stopped publishing images)
STORAGE_PUBLIC_URL=
STORAGE_QUOTA_MB=1024
STORAGE_MAX_OBJECT_MB=
STORAGE_MAX_UPLOAD_MB=16

# ============================================================ runtime service limits (empty = built-in default)
# comma separated image prefixes users may reference via the public API (empty = any valid reference)
RUNTIME_ALLOWED_IMAGE_PREFIXES=
RUNTIME_RECONCILE_INTERVAL=
RUNTIME_DRAIN_TIME=
RUNTIME_STOP_TIMEOUT=
RUNTIME_HEALTH_TIMEOUT=
RUNTIME_HEALTH_INTERVAL=
RUNTIME_MAX_MEMORY_MB=
RUNTIME_MAX_CPUS=
RUNTIME_MAX_JOBS=
RUNTIME_JOB_TIMEOUT=
RUNTIME_JOB_MAX_TIMEOUT=
# allow *.internal/*.test style hostnames for custom domains (tests only)
DOMAIN_ALLOW_INTERNAL_TLDS=false
PREVIEW_TLS=false

# ============================================================ worker / registry (empty = built-in default)
GIT_ALLOWED_HOSTS=
TRIVY_TIMEOUT=
WORKER_BUILD_MEMORY=
WORKER_BUILD_TIMEOUT=
WORKER_CLONE_TIMEOUT=
WORKER_PUSH_TIMEOUT=
WORKER_CLAIM_IDLE=
WORKER_DRAIN_TIMEOUT=120s
WORKER_MAX_ATTEMPTS=
WORKER_MAX_REPO_MB=
WORKER_MIN_FREE_MB=
REGISTRY_USER=
REGISTRY_PASSWORD=
ADDON_CATALOG_DIR=
METRICS_SAMPLE_INTERVAL=

# ============================================================ scheduler / cleanup
CLEANUP_INTERVAL=1h
PREVIEW_TTL=72h
ORPHAN_IMAGE_TTL=168h

# ============================================================ TLS probe / test DNS (advanced)
TLS_PROBE_ADDR=traefik:443
# host:port of a DNS server the domain service uses for verification. Empty = system resolver. e2e override sets dns:53.
DNS_RESOLVER=

# ============================================================ monitoring profile (optional)
# Start with: scripts/jp-up.sh --monitoring
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
# Optional public hostname for Grafana through Traefik (Grafana's own login protects it)
GRAFANA_DOMAIN=
# GRAFANA_ROOT_URL=
LOKI_URL=
# days of build/runtime logs kept in the logging service
LOG_RETENTION_DAYS=14
# days of metric samples kept (empty = built-in default)
METRICS_RETENTION_DAYS=
PROMETHEUS_RETENTION=7d
METRICS_MODE=live
OTEL_EXPORTER_OTLP_ENDPOINT=

# ============================================================ resource sizing (written by scripts/size-host.sh)
# JP_SIZE=small|medium|large|xlarge
WORKER_CONCURRENCY=1
WORKER_NAME=

# ============================================================ ports / binds
# Only Traefik (80/443) is public. Everything else binds 127.0.0.1.
HTTP_PORT=80
HTTPS_PORT=443
# 0.0.0.0 would expose the dashboard directly on 3000 (install.sh --ip-only does that); default is loopback behind Traefik
DASHBOARD_BIND=127.0.0.1
DASHBOARD_PORT=3000
GATEWAY_PORT=8000
TRAEFIK_DASHBOARD_PORT=8080
REGISTRY_PORT=5000
# bind addresses for Traefik (0.0.0.0 default); host ports of loopback-only tools
HTTP_BIND=0.0.0.0
HTTPS_BIND=0.0.0.0
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
LOKI_PORT=3100
TEMPO_PORT=3200
# dev override only (docker-compose.dev.yml publishes these on 127.0.0.1)
POSTGRES_PORT=5432
REDIS_PORT=6379
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
# e2e override: host port of the test DNS server
E2E_DNS_PORT=5353
# misc
TRAEFIK_LOG_LEVEL=INFO
MINIO_BROWSER=on
REDIS_MAXMEMORY=192mb
JP_VERSION=dev
JP_COMMIT=unknown
NEXT_PUBLIC_API_URL=/api/v1

# ---------------------------------------------------------------------------------------------------------------
# Multi-server (optional). Leave empty on a single server.
# CONTROL_PLANE_PRIVATE_IP   this server's address on the private network; joining servers allow their node agent
#                            and app ports only from it.
# REGISTRY_PRIVATE_BIND/PORT publish the image registry on the private network so joining servers can pull images
#                            (default: an unused loopback port, nothing exposed).
# NODE_REGISTRY_UPSTREAM     host:port joining servers use to reach that registry, e.g. 10.0.0.41:5000
# ---------------------------------------------------------------------------------------------------------------
CONTROL_PLANE_PRIVATE_IP=
REGISTRY_PRIVATE_BIND=127.0.0.1
REGISTRY_PRIVATE_PORT=5001
NODE_REGISTRY_UPSTREAM=

# Traefik admin surfaces. Both are OFF by default because tenant containers on the host network path could otherwise reach them.
TRAEFIK_DASHBOARD=false
TRAEFIK_METRICS=false
