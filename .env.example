# jp Cloud Platform — Environment Template
# Copy to .env and adjust. Never commit real secrets.

# --- Core ---
JP_ENV=development
JP_LOG_LEVEL=info
JWT_SECRET=change-me-to-a-long-random-secret-in-production
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h

# --- Postgres ---
POSTGRES_USER=jp
POSTGRES_PASSWORD=jp_dev_password
POSTGRES_DB=jp
DATABASE_URL=postgres://jp:jp_dev_password@postgres:5432/jp?sslmode=disable

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Service URLs (internal) ---
IDENTITY_URL=http://identity:8001
ORGANIZATION_URL=http://organization:8002
PROJECT_URL=http://project:8003
NOTIFICATION_URL=http://notification:8004
REPOSITORY_URL=http://repository:8005
DEPLOYMENT_URL=http://deployment:8006
BUILD_URL=http://build:8007
REGISTRY_URL=http://registry-api:8009
RUNTIME_URL=http://runtime:8010
SCHEDULER_URL=http://scheduler:8011
DOMAIN_URL=http://domain:8012
CERTIFICATE_URL=http://certificate:8013
SECRET_URL=http://secret:8014
LOGGING_URL=http://logging:8015
METRICS_URL=http://metrics:8016
STORAGE_URL=http://storage:8017
DATABASE_SVC_URL=http://database:8018
ADDON_SVC_URL=http://addon:8021
AI_URL=http://ai:8019
BILLING_URL=http://billing:8020
GATEWAY_URL=http://gateway:8000

# --- Gateway / public ---
PUBLIC_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
GITHUB_WEBHOOK_SECRET=dev-webhook-secret
# Optional: personal token for repo list when GitHub App is not configured
# GITHUB_TOKEN=
# --- GitHub App (real install + installation repos + commit statuses) ---
# Create at https://github.com/settings/apps — set Setup URL to:
#   http://localhost:8000/api/v1/github/setup
# Webhook URL:
#   http://localhost:8000/api/v1/webhooks/github
# GITHUB_APP_ID=
# GITHUB_APP_SLUG=
# Paste PEM with \n escapes, or set path:
# GITHUB_APP_PRIVATE_KEY=
# GITHUB_APP_PRIVATE_KEY_PATH=
# GITHUB_APP_CLIENT_ID=
# GITHUB_APP_CLIENT_SECRET=
# DASHBOARD_URL=http://localhost:3000
# --- Modes: real by default (set simulate=* only for demos without Docker) ---
BUILD_MODE=docker
SIMULATE_BUILD=false
RUNTIME_MODE=docker
DOMAIN_DNS_STUB=false
DOMAIN_CNAME_TARGET=cname.jp.localhost
CERT_SIMULATE=false
# TRAEFIK_CERT_RESOLVER=letsencrypt
# Host Docker daemon push target (worker uses docker.sock)
REGISTRY_PUSH_URL=host.docker.internal:5000
REGISTRY_HOST=host.docker.internal:5000
SCHEDULER_SLOT=node-1
CLEANUP_INTERVAL=1h
PREVIEW_TTL=72h
PREVIEW_BASE_DOMAIN=preview.jp.localhost
ORPHAN_IMAGE_TTL=168h

# --- Phase 5 ops ---
# Leave empty to use fixed local AES key (simulate-friendly). Set a 32-byte key in prod.
# SECRETS_MASTER_KEY=
METRICS_MODE=live
# Set when --profile monitoring is up:
# LOKI_URL=http://loki:3100
# PROMETHEUS_URL=http://prometheus:9090
# OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo:4318
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# --- Phase 6 data (use with --profile data) ---
STORAGE_MODE=minio
# STORAGE_MODE=simulate
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=minio:9000
MINIO_PUBLIC_URL=http://localhost:9000
DB_MODE=schema
# DB_MODE=simulate

# --- One-click add-ons (profile data = addon API; profile addons = shared brokers) ---
ADDON_MODE=simulate
# ADDON_MODE=shared
# When using --profile addons + ADDON_MODE=shared:
# MYSQL_PROVISION_URL=jp:jp_dev_password@tcp(mysql:3306)/
# MONGO_PROVISION_URL=mongodb://jp:jp_dev_password@mongo:27017
# REDIS_ADDON_URL=redis://redis-addon:6379/0
# RABBITMQ_MANAGEMENT_URL=http://rabbitmq:15672
# RABBITMQ_AMQP_HOST=rabbitmq:5672
# RABBITMQ_ADMIN_USER=jp
# RABBITMQ_ADMIN_PASSWORD=jp_dev_password
# KAFKA_BROKERS=redpanda:9092
# ADDON_SQLITE_DIR=/var/jp/addons/sqlite

# --- Phase 7 AI (no local LLM) ---
# Leave OPENAI_API_KEY empty for heuristic "simulate" explanations.
# OPENAI_API_KEY=
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini

# --- Resource sizing (adaptive — not locked to 4GB) ---
# Run scripts/size-host.ps1 (or size-host.sh) to auto-detect host RAM/CPU and write .env.resources.
# Or set manually:
# JP_SIZE=small|medium|large|xlarge
# WORKER_REPLICAS=1
# WORKER_CONCURRENCY=1
# Prefer: .\scripts\jp-up.ps1  (applies sizing overlay + scales workers)

# --- Ports ---
GATEWAY_PORT=8000
IDENTITY_PORT=8001
ORGANIZATION_PORT=8002
PROJECT_PORT=8003
NOTIFICATION_PORT=8004
REPOSITORY_PORT=8005
DEPLOYMENT_PORT=8006
BUILD_PORT=8007
WORKER_PORT=8008
REGISTRY_API_PORT=8009
RUNTIME_PORT=8010
SCHEDULER_PORT=8011
DOMAIN_PORT=8012
CERTIFICATE_PORT=8013
SECRET_PORT=8014
LOGGING_PORT=8015
METRICS_PORT=8016
STORAGE_PORT=8017
DATABASE_PORT=8018
AI_PORT=8019
BILLING_PORT=8020
ADDON_PORT=8021
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
