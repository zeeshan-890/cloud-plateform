{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jp.dev/schemas/jp.yaml.json",
  "title": "jp.yaml",
  "description": "jp project manifest. Read from the repository root at build time.",
  "type": "object",
  "required": [
    "name",
    "runtime"
  ],
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 63,
      "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$"
    },
    "description": {
      "type": "string",
      "maxLength": 512
    },
    "runtime": {
      "type": "string",
      "enum": [
        "nodejs",
        "python",
        "go",
        "docker",
        "static",
        "node22",
        "node"
      ]
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "command": {
          "type": "string"
        },
        "dockerfile": {
          "type": "string"
        },
        "context": {
          "type": "string",
          "default": "."
        },
        "output": {
          "type": "string"
        },
        "env": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "Plain (non-secret) build args. Never put secrets here."
        }
      }
    },
    "deploy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "region": {
          "type": "string"
        },
        "replicas": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10,
          "default": 1
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "strategy": {
          "type": "string",
          "enum": [
            "rolling",
            "blue_green"
          ],
          "default": "rolling",
          "description": "rolling (default): new container joins the same Traefik service, passes the HTTP health gate, then the old one drains. blue_green: new colour gets its own service; routes flip after the gate."
        },
        "healthcheck": {
          "type": "string"
        },
        "env": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "restart": {
          "type": "string",
          "enum": [
            "on-failure",
            "always",
            "never"
          ],
          "default": "on-failure"
        },
        "health_timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 600
        }
      }
    },
    "domains": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "hostname"
      }
    },
    "env": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "description": "Container limits (clamped by the platform).",
      "properties": {
        "memory": {
          "type": [
            "string",
            "integer"
          ],
          "description": "e.g. 512MB, 1g or a number of MB (default 512MB)"
        },
        "cpus": {
          "type": [
            "number",
            "string"
          ],
          "description": "CPU cores, e.g. 0.5 (default 1)"
        }
      }
    },
    "security": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "block_on_critical": {
          "type": "boolean",
          "default": false,
          "description": "Fail the build when the Trivy scan finds CRITICAL vulnerabilities or cannot run."
        }
      }
    }
  }
}